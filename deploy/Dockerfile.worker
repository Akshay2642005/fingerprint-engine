# Worker runtime image.
#
# The worker binary is built by the zig build system on the host
# (`zig build worker --release=safe`) and docker only packages it — nothing
# is compiled inside the image. `alpine` + `tini` give the container a sane
# PID 1 (docker stop sends SIGTERM to tini, which forwards it to the worker
# and reaps it, so shutdown never hangs).
#
# Build:   zig build docker:worker
#   (or)   zig build worker --release=safe && docker build -f deploy/Dockerfile.worker -t fingerprint-worker:0.2.0 .
# Run:     docker run --rm -p 8080:8080 fingerprint-worker:0.2.0
#
# Note: build the image on Linux (CI or WSL2) — the binary copied in must be
# the Linux static build, not the local Windows .exe.
FROM alpine:latest
RUN apk add --no-cache tini
COPY zig-out/bin/worker /worker
EXPOSE 8080
ENTRYPOINT ["tini", "--", "/worker", "start", "--transport=tcp", "--listen=0.0.0.0:8080", "--publish=none"]
