# syntax=docker/dockerfile:1
FROM alpine:3.22 AS builder

ARG ZIG_VERSION=0.14.1

RUN apk add --no-cache \
    curl \
    xz \
    ca-certificates

WORKDIR /app

# Install official Zig 0.14.1 Linux x86_64 release.
RUN curl -fsSL \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
        -o /tmp/zig.tar.xz \
    && tar -xf /tmp/zig.tar.xz -C /opt \
    && ln -s "/opt/zig-x86_64-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && rm /tmp/zig.tar.xz

RUN zig version

# Copy dependency manifests first.
COPY build.zig build.zig.zon ./

# Copy source.
COPY . .

# Build the worker for Linux.
#
# x86_64-linux-musl gives us a binary suitable for Alpine.
RUN zig build worker \
    -Dtarget=x86_64-linux-musl \
    --release=safe


FROM alpine:3.22 AS runtime

RUN apk add --no-cache tini \
    && addgroup -S worker \
    && adduser -S \
        -G worker \
        -h /nonexistent \
        -s /sbin/nologin \
        worker

COPY --from=builder \
    --chown=worker:worker \
    /app/zig-out/bin/worker \
    /usr/local/bin/worker

RUN chmod 0555 /usr/local/bin/worker

USER worker

EXPOSE 8080

ENTRYPOINT ["/sbin/tini", "--"]

CMD ["/usr/local/bin/worker", \
     "start", \
     "--transport=tcp", \
     "--listen=0.0.0.0:8080", \
     "--publish=none"]
