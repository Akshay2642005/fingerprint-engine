{
	"compilerOptions": {
		"strict": true,
		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": [],
		"noEmit": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": false
	},
	"include": ["types/**/*.ts"]
}
